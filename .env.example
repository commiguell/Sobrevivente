# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# CONFIGURAÇÃO DA BASE DE DADOS MYSQL — SERVIDOR HOSTINGER
# Copie este ficheiro para .env e preencha com os dados do hPanel da Hostinger:
# ==============================================================================

# Endereço do Servidor MySQL da Hostinger (normalmente 'localhost' ou IP fornecido no hPanel)
DB_HOST="localhost"

# Porta do MySQL (padrão: 3306)
DB_PORT="3306"

# Nome da Base de Dados criada no hPanel da Hostinger (ex: u123456789_sobrevivente)
DB_NAME="u123456789_sobrevivente"

# Utilizador MySQL criado no hPanel com privilégios totais (ex: u123456789_admin)
DB_USER="u123456789_admin"

# Palavra-passe forte configurada para o utilizador da Base de Dados
DB_PASSWORD="SuaPasswordSeguraAqui123!#"

# Ativar SSL na conexão MySQL (true se a Hostinger exigir conexão SSL remota, false para localhost)
DB_SSL="false"

# Ambiente de execução: 'development' ou 'production'
NODE_ENV="production"

# Segredo para assinatura de Tokens JWT ou sessões (opcional)
JWT_SECRET="chave_secreta_longa_e_aleatoria_com_pelo_menos_32_caracteres"
