{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"custom": true,
			"customGradient": false,
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "base", "name": "Base", "color": "#FFFFFF" },
				{ "slug": "surface", "name": "Superfície", "color": "#EEF4F7" },
				{ "slug": "contrast", "name": "Contraste", "color": "#0F1B24" },
				{ "slug": "muted", "name": "Texto secundário", "color": "#45545F" },
				{ "slug": "primary", "name": "Primária", "color": "#0B4F6C" },
				{ "slug": "primary-strong", "name": "Primária forte", "color": "#083B51" },
				{ "slug": "accent", "name": "Destaque", "color": "#FFC845" },
				{ "slug": "border", "name": "Contorno", "color": "#6A7B87" },
				{ "slug": "error", "name": "Erro", "color": "#A3242F" },
				{ "slug": "success", "name": "Sucesso", "color": "#1E6B3A" }
			]
		},
		"layout": {
			"contentSize": "720px",
			"wideSize": "1200px"
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [ "px", "rem", "em", "%", "vw", "vh" ],
			"spacingSizes": [
				{ "slug": "10", "name": "1", "size": "0.5rem" },
				{ "slug": "20", "name": "2", "size": "0.75rem" },
				{ "slug": "30", "name": "3", "size": "1rem" },
				{ "slug": "40", "name": "4", "size": "clamp(1.25rem, 3vw, 1.5rem)" },
				{ "slug": "50", "name": "5", "size": "clamp(1.5rem, 4vw, 2.5rem)" },
				{ "slug": "60", "name": "6", "size": "clamp(2rem, 6vw, 4rem)" },
				{ "slug": "70", "name": "7", "size": "clamp(3rem, 8vw, 6rem)" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"writingMode": false,
			"fontFamilies": [
				{
					"slug": "body",
					"name": "Inter",
					"fontFamily": "Inter, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/inter/Inter-latin-wght-normal.woff2" ]
						}
					]
				},
				{
					"slug": "system",
					"name": "Sistema",
					"fontFamily": "system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif"
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Pequeno", "size": "0.875rem", "fluid": false },
				{ "slug": "medium", "name": "Normal", "size": "1rem", "fluid": { "min": "1rem", "max": "1.0625rem" } },
				{ "slug": "large", "name": "Grande", "size": "1.25rem", "fluid": { "min": "1.125rem", "max": "1.375rem" } },
				{ "slug": "x-large", "name": "Muito grande", "size": "1.75rem", "fluid": { "min": "1.5rem", "max": "2rem" } },
				{ "slug": "xx-large", "name": "Enorme", "size": "2.5rem", "fluid": { "min": "1.875rem", "max": "3.25rem" } }
			]
		},
		"custom": {
			"radius": { "small": "6px", "medium": "12px" },
			"focus": { "width": "3px", "offset": "2px" },
			"touch-target": "44px",
			"sticky-cta-height": "64px"
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--40)",
			"padding": {
				"left": "var(--wp--preset--spacing--30)",
				"right": "var(--wp--preset--spacing--30)"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--primary)" },
				"typography": { "textDecoration": "underline" },
				":hover": {
					"color": { "text": "var(--wp--preset--color--primary-strong)" },
					"typography": { "textDecoration": "none" }
				},
				":focus": {
					"outline": {
						"color": "var(--wp--preset--color--primary)",
						"offset": "var(--wp--custom--focus--offset)",
						"style": "solid",
						"width": "var(--wp--custom--focus--width)"
					}
				}
			},
			"button": {
				"border": { "radius": "var(--wp--custom--radius--small)" },
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--base)"
				},
				"spacing": {
					"padding": {
						"top": "0.75rem",
						"bottom": "0.75rem",
						"left": "1.25rem",
						"right": "1.25rem"
					}
				},
				"typography": {
					"fontWeight": "600",
					"lineHeight": "1.25",
					"textDecoration": "none"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--primary-strong)",
						"text": "var(--wp--preset--color--base)"
					}
				},
				":focus": {
					"outline": {
						"color": "var(--wp--preset--color--contrast)",
						"offset": "var(--wp--custom--focus--offset)",
						"style": "solid",
						"width": "var(--wp--custom--focus--width)"
					}
				}
			},
			"heading": {
				"typography": { "fontWeight": "700", "lineHeight": "1.2" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)", "letterSpacing": "-0.02em" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } }
		},
		"blocks": {
			"core/site-title": {
				"typography": { "fontSize": "var(--wp--preset--font-size--large)", "fontWeight": "700" },
				"elements": {
					"link": {
						"color": { "text": "var(--wp--preset--color--contrast)" },
						"typography": { "textDecoration": "none" }
					}
				}
			},
			"core/navigation": {
				"typography": { "fontSize": "var(--wp--preset--font-size--medium)", "fontWeight": "500" }
			},
			"core/separator": {
				"color": { "text": "var(--wp--preset--color--border)" }
			},
			"transfer-me/booking-form": {
				"color": {
					"background": "var(--wp--preset--color--base)",
					"text": "var(--wp--preset--color--contrast)"
				},
				"border": {
					"color": "var(--wp--preset--color--border)",
					"radius": "var(--wp--custom--radius--medium)",
					"style": "solid",
					"width": "1px"
				},
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--40)",
						"bottom": "var(--wp--preset--spacing--40)",
						"left": "var(--wp--preset--spacing--30)",
						"right": "var(--wp--preset--spacing--30)"
					}
				},
				"shadow": "0 8px 24px rgb(15 27 36 / 0.08)",
				"css": "& .tmb{max-width:none}& .tmb > h2{margin-top:0}"
			}
		}
	},
	"customTemplates": [
		{ "name": "page-reservar", "title": "Reservar", "postTypes": [ "page" ] }
	],
	"templateParts": [
		{ "name": "header", "title": "Cabeçalho", "area": "header" },
		{ "name": "footer", "title": "Rodapé", "area": "footer" }
	]
}
